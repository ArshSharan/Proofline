{
  "name": "proofline",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build:core",
    "dev": "concurrently -n \"lab,web\" -c \"blue,green\" \"npm run dev --workspace=apps/lab\" \"npm run dev --workspace=apps/web\"",
    "dev:lab": "npm run dev --workspace=apps/lab",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:core": "npm run build --workspace=packages/core",
    "build": "npm run build:core && npm run build --workspace=apps/lab && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:core && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:hardened": "cross-env LAB_MODE=hardened npm run test --workspace=apps/lab",
    "test:proof": "node scripts/proof.mjs",
    "audit:deps": "npm audit --json > docs/evidence/audit.json 2>&1 || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
